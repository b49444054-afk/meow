import re

import streamlit as st

from lms import engine, storage

st.set_page_config(page_title="Smart LMS", page_icon="🎓", layout="wide")

STATUS_ICON = {"completed": "✅", "unlocked": "🔓", "locked": "🔒"}

# ---------- small custom styling ----------
st.markdown(
    """
    <style>
      .block-container {padding-top: 2rem;}
      .hero {padding: 1.2rem 1.5rem; border-radius: 14px;
             background: linear-gradient(135deg,#4f46e5,#06b6d4); color: white;}
      .hero h2 {margin: 0; color: white;}
      .hero p {margin: .3rem 0 0 0; opacity: .9;}
    </style>
    """,
    unsafe_allow_html=True,
)


# ---------- helpers ----------
def clean_username(raw: str) -> str:
    return re.sub(r"[^a-z0-9_]", "", raw.strip().lower().replace(" ", "_"))[:30]


def attempt_key(course_id, module_id):
    return f"attempt_{course_id}_{module_id}"


def result_key(course_id, module_id):
    return f"result_{course_id}_{module_id}"


# ---------- sidebar: login + course ----------
courses = engine.load_courses()

with st.sidebar:
    st.title("🎓 Smart LMS")
    name = st.text_input("Your name", value=st.session_state.get("user", ""),
                         placeholder="e.g. rajat")
    user = clean_username(name)
    st.session_state["user"] = user

    if not user:
        st.info("Enter your name to start. Your progress is saved under it.")
        st.stop()

    course_id = st.selectbox(
        "Course", list(courses), format_func=lambda c: f"{courses[c]['icon']} {courses[c]['title']}"
    )

course = courses[course_id]
progress = storage.get_progress(user, course_id)
summary = engine.course_summary(course, progress)
modules = course["modules"]

with st.sidebar:
    st.progress(summary["percent"] / 100, text=f"{summary['completed']}/{summary['total']} modules done")
    labels = [
        f"{STATUS_ICON[engine.module_status(course, progress, i)]}  {i + 1}. {m['title']}"
        for i, m in enumerate(modules)
    ]
    # Default selection: first module that is not yet completed.
    first_open = next(
        (i for i in range(len(modules)) if engine.module_status(course, progress, i) != "completed"),
        len(modules) - 1,
    )
    choice = st.radio("Modules", range(len(modules)), format_func=lambda i: labels[i],
                      index=first_open, key=f"nav_{course_id}")
    st.divider()
    if st.button("Reset my progress for this course"):
        storage.reset_progress(user, course_id)
        for k in [k for k in st.session_state if k.startswith(("attempt_", "result_"))]:
            del st.session_state[k]
        st.rerun()

module = modules[choice]
status = engine.module_status(course, progress, choice)
threshold = module.get("pass_threshold", course["pass_threshold"])

# ---------- header ----------
st.markdown(
    f"<div class='hero'><h2>{course['icon']} {course['title']}</h2><p>{course['description']}</p></div>",
    unsafe_allow_html=True,
)
st.write("")
c1, c2, c3 = st.columns(3)
c1.metric("Completion", f"{summary['percent']}%")
c2.metric("Average best score", f"{summary['avg_best_score']}%")
c3.metric("Quiz attempts", summary["attempts"])

# ---------- locked module ----------
if status == "locked":
    prev = modules[choice - 1]
    st.warning(
        f"🔒 **{module['title']}** is locked. Score at least "
        f"**{prev.get('pass_threshold', course['pass_threshold'])}%** on the quiz for "
        f"**{prev['title']}** to unlock it."
    )
    st.stop()

# ---------- unlocked module: tabs ----------
st.subheader(f"Module {choice + 1}: {module['title']}")
tab_learn, tab_quiz, tab_dash = st.tabs(["📖 Learn", "📝 Quiz", "📊 My Progress"])

with tab_learn:
    st.markdown(module["content"])
    st.caption("When you're ready, open the Quiz tab.")

with tab_quiz:
    rec = progress.get(module["id"])
    if rec:
        st.caption(f"Best score: {rec['best_score']}%  |  Attempts: {rec['attempts']}  |  "
                   f"Pass mark: {threshold}%")
    else:
        st.caption(f"Pass mark: {threshold}%")

    a_key = attempt_key(course_id, module["id"])
    r_key = result_key(course_id, module["id"])
    attempt = st.session_state.get(a_key, 0)
    result = st.session_state.get(r_key)

    if result is None:
        with st.form(f"quiz_{course_id}_{module['id']}_{attempt}"):
            answers = {}
            for i, q in enumerate(module["quiz"]):
                answers[i] = st.radio(
                    f"**Q{i + 1}. {q['question']}**",
                    range(len(q["options"])),
                    format_func=lambda j, q=q: q["options"][j],
                    index=None,
                    key=f"q_{course_id}_{module['id']}_{attempt}_{i}",
                )
                st.write("")
            submitted = st.form_submit_button("Submit answers", type="primary")

        if submitted:
            if any(a is None for a in answers.values()):
                st.error("Please answer every question before submitting.")
            else:
                graded = engine.grade_quiz(module, answers)
                graded["passed"] = engine.is_passed(graded["score"], course, module)
                storage.save_module_result(user, course_id, module["id"],
                                           graded["score"], graded["passed"])
                st.session_state[r_key] = graded
                st.rerun()
    else:
        # ----- result screen -----
        st.metric("Your score", f"{result['score']}%",
                  f"{result['correct']}/{result['total']} correct")
        if result["passed"]:
            st.success("🎉 You passed!")
            if choice + 1 < len(modules):
                st.info(f"Next module unlocked: **{modules[choice + 1]['title']}**. "
                        "Pick it from the sidebar.")
            else:
                st.balloons()
                st.success("You completed the whole course!")
        else:
            st.error(f"Not there yet. You need {threshold}% to unlock the next module.")
            st.markdown("#### 🩹 Remedial tips")
            for tip in engine.remedial_feedback(module, result):
                st.markdown(f"- {tip}")
            st.caption("Re-read the Learn tab, then try again.")

        if result["wrong"]:
            with st.expander("Review the questions you missed", expanded=not result["passed"]):
                for w in result["wrong"]:
                    st.markdown(f"**{w['question']}**")
                    st.markdown(f"- Your answer: {w['your_answer']}\n- Correct answer: {w['correct_answer']}")
                    st.caption(w["explanation"])

        if st.button("Retake quiz" if not result["passed"] else "Practice again"):
            del st.session_state[r_key]
            st.session_state[a_key] = attempt + 1
            st.rerun()

with tab_dash:
    st.markdown("#### Module overview")
    for i, m in enumerate(modules):
        s = engine.module_status(course, progress, i)
        rec = progress.get(m["id"], {})
        col_a, col_b = st.columns([3, 2])
        col_a.markdown(f"{STATUS_ICON[s]} **{i + 1}. {m['title']}**")
        if rec:
            col_b.progress(rec["best_score"] / 100,
                           text=f"Best {rec['best_score']}% · {rec['attempts']} attempt(s)")
        else:
            col_b.caption(s.capitalize())
